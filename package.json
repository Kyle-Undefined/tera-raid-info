{
	"name": "tera-raid-info",
	"version": "3.0.0",
	"description": "Aggregate view of the [Serebii](https://www.serebii.net/) Tera Raid Info for Pokemon Scarlet & Violet.",
	"scripts": {
		"ng": "ng",
		"dev": "ng serve",
		"build": "ng build",
		"build:prod": "ng build --configuration production --base-href /tera-raid-info/",
		"watch": "ng build --watch --configuration development",
		"lint": "oxlint src/ e2e/ playwright.config.ts vitest.config.mts",
		"lint:fix": "oxlint src/ e2e/ playwright.config.ts vitest.config.mts --fix",
		"test": "vitest",
		"test:headless": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit -p tsconfig.spec.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kyle-Undefined/tera-raid-info.git"
	},
	"keywords": [],
	"author": "Kyle Undefined",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Kyle-Undefined/tera-raid-info/issues"
	},
	"homepage": "https://github.com/Kyle-Undefined/tera-raid-info#readme",
	"dependencies": {
		"@angular/common": "22.2.2",
		"@angular/compiler": "22.2.2",
		"@angular/core": "22.2.2",
		"@angular/forms": "22.2.2",
		"@angular/platform-browser": "22.2.2",
		"@apollo/client": "4.3.3",
		"apollo-angular": "14.2.0",
		"graphql": "17.0.2",
		"rxjs": "7.8.2",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "2.8.0",
		"@angular/build": "22.2.2",
		"@angular/cli": "22.2.2",
		"@angular/compiler-cli": "22.2.2",
		"@favware/graphql-pokemon": "8.8.1",
		"@playwright/test": "1.64.0",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.3",
		"@vitest/ui": "5.0.3",
		"jsdom": "30.1.2",
		"oxlint": "1.87.0",
		"postcss": "8.5.29",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vitest": "5.0.3"
	},
	"packageManager": "npm@11.19.0",
	"engines": {
		"node": ">=24.21.0 <25",
		"npm": ">=11.19.0 <12"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.28.2": true,
		"lmdb@3.5.6": true,
		"msgpackr-extract@3.0.4": true
	}
}
